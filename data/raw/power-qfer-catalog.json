{"help": "https://publish.data.ca.gov/api/3/action/help_show?name=package_show", "success": true, "result": {"accessLevel": "public", "accrualPeriodicity": "irregular", "author_email": null, "conformsTo": "", "contact_email": "michael.nyberg@energy.ca.gov", "contact_name": "Michael Nyberg", "creator_user_id": "be1db721-b4f5-4257-abcb-c2115ad06ee3", "id": "08a20692-ad33-4556-8b0b-4db153124688", "isopen": true, "language": "", "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2025-07-02T15:51:32.597615", "metadata_modified": "2026-10-08T18:32:53.557845", "name": "qfer-cec-1304-power-plant-owner-reporting-database", "notes": "Following an Order Instituting Rulemaking initiated in October 2005, amendments adopted by the Energy Commission and approved by California's Office of Administrative Law in July 2007 created two articles: Article 1, known as Quarterly Fuel and Energy Report (QFER) directed at current California energy information, and Article 2 directed at the forecast and assessment of energy loads and resources. The regulations under QFER provide for the collection of energy data relating to electric generation, control area exchanges, and natural gas processing and deliveries. The reports are submitted on forms specified by the Energy Commission's executive director. \r\n\r\nThe statistics presented here are derived from the QFER CEC-1304 Power Plant Owner Reporting Form. The CEC-1304 reporting form collects data from power plants with a total nameplate capacity of 1MW or more that are located within California or within a control area with end users inside California. The information includes gross generation, net generation, fuel use by fuel type for each generator, as well as total electricity consumed on site and electricity sales for the plant as a whole. Power plants with nameplate capacity of 20 megawatts or more also provide environmental information related to water supply and water/wastewater discharge. \r\n\r\nDatabase and Source Files updated: June 07, 2017", "num_resources": 7, "num_tags": 14, "organization": {"id": "cd40c9f3-dedd-466f-8b57-922ef7276e3a", "name": "california-energy-commission", "title": "California Energy Commission", "type": "organization", "description": "Website: https://www.energy.ca.gov/\r\n\r\nAs the state's primary energy policy and planning agency, the California Energy Commission is committed to reducing energy costs and environmental impacts of energy use - such as greenhouse gas emissions - while ensuring a safe, resilient, and reliable supply of energy.", "image_url": "2018-12-07-184700.587936CECLogo.jpg", "created": "2026-09-30T19:02:09.153122", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "cd40c9f3-dedd-466f-8b57-922ef7276e3a", "private": false, "rights": "No restrictions on public use", "state": "active", "temporal": "", "title": "QFER CEC-1304 Power Plant Owner Reporting Database", "type": "dataset", "url": "http://www.energy.ca.gov/almanac/electricity_data/web_qfer/", "version": null, "extras": [{"key": "guid", "value": "9d0b1ab8-14af-4828-885c-e29421586a2c"}, {"key": "dcat_issued", "value": "2017-12-26T16:37:38.099441"}, {"key": "dcat_modified", "value": "2020-10-28T17:50:09.841864"}, {"key": "dcat_publisher_name", "value": "California Energy Commission"}], "groups": [{"description": "Themes include wildlife, fire, farmland, land use, renewable energy, geology, recreation.", "display_name": "Natural Resources", "id": "43dcc259-6574-4a5e-b582-b7baa904c75c", "image_display_url": "https://publish.data.ca.gov/uploads/group/2020-02-06-210729.296880plant.png", "name": "natural-resources", "title": "Natural Resources"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2026-09-30T19:07:27.953226", "datastore_active": false, "description": "", "format": "HTML", "ha