{"help": "https://publish.data.ca.gov/api/3/action/help_show?name=package_show", "success": true, "result": {"accessLevel": "public", "accrualPeriodicity": "irregular", "additional_information": "", "author": "California Office of Environmental Health Hazard Assessment", "author_email": null, "citation": "", "conformsTo": "", "contact_email": "calenviroscreen@oehha.ca.gov", "contact_name": "California Office of Environmental Health Hazard Assessment", "creator_user_id": "2db3d565-fba0-446e-97cf-39774e1bdb05", "geo_coverage": "California", "granularity": "Census Tract", "group": "", "id": "72b28c84-ceac-4886-9f71-d422470d2223", "isopen": false, "landingPage": "https://oehha.ca.gov/calenviroscreen", "language": "", "license_id": "notspecified", "license_title": "License not specified", "maintainer": null, "maintainer_email": null, "metadata_created": "2026-06-16T18:53:23.622195", "metadata_modified": "2026-10-05T19:54:19.333896", "name": "calenviroscreen-5-0", "notes": "CalEnviroScreen is a mapping tool that helps identify California communities that are most affected by many sources of pollution, and where people are often especially vulnerable to pollution\u2019s effects. CalEnviroScreen uses environmental, health, and socioeconomic information to produce scores for every census tract in the state. The scores are mapped so that different communities can be compared. An area with a high score is one that experiences a much higher pollution burden than areas with low scores. CalEnviroScreen ranks communities based on data that are available from state and federal government sources.", "num_resources": 6, "num_tags": 3, "organization": {"id": "815099cf-ce2b-403f-a507-fa654c0910a3", "name": "california-office-of-environmental-health-hazard-assessment", "title": "California Office of Environmental Health Hazard Assessment", "type": "organization", "description": "Website: https://oehha.ca.gov/\r\n\r\nThe mission of the Office of Environmental Health Hazard Assessment (OEHHA) is to protect and enhance public health and the environment by scientific evaluation of risks posed by hazardous substances.", "image_url": "2018-12-07-181628.587810OEHHAlogo.jpg", "created": "2026-09-30T19:02:13.277388", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "815099cf-ce2b-403f-a507-fa654c0910a3", "private": false, "related_resources": "", "rights": "No restrictions on public use", "secondary_sources": "", "spatial": "", "state": "active", "temporal": "", "title": "CalEnviroScreen 5.0", "type": "dataset", "url": "", "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2026-09-30T21:00:41.722505", "datastore_active": false, "description": "ArcGIS layer file containing CalEnviroScreen 5.0 results fully formatted with a red-to-green color scheme.", "format": "LYRX", "hash": "", "id": "dfdcd112-911e-4d2c-94e7-0208493d0acf", "last_modified": "2026-10-01T14:56:00.953364", "metadata_modified": "2026-10-01T14:56:01.105650", "mimetype": null, "mimetype_inner": null, "name": "CalEnviroScreen 5.0 ArcGIS Layer", "package_id": "72b28c84-ceac-4886-9f71-d422470d2223", "position": 0, "resource_type": null, "size": 98752, "state": "active", "url": "https://publish.data.ca.gov/dataset/72b28c84-ceac-4886-9f71-d422470d2223/resource/dfdcd112-911e-4d2c-94e7-0208493d0acf/download/calenviroscreen50results_f_070126.lyrx", "url_type": "upload"}, {"cache_last_updated": null, "cache_url": null, "created": "2026-09-30T21:00:41.722510", "datastore_active": false, "description": "Spatial geodatabase file containing CalEnviroScreen 5.0 results. Data includes individual indicator scores, geographic information, and demographics.", "format": "GDB", "hash": "", "id": "64a0fdd4-ccb1-4bfb-ba41-22c4ee2f3e14", "last_modified": "2026-10-01T14:56:05.777471", "metadata_modified": "2026-10-01T14:56:05.915292", "mimetype": null, "mimetype_inner": null, "name": "CalEnviroScreen 5.0 Geodatabase", "package_id": "72b28c