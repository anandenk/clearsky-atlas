{"help": "https://data.chhs.ca.gov/api/3/action/help_show?name=package_show", "success": true, "result": {"accrual_periodicity": "monthly", "additional_information": "", "additional_limitations": "", "author": "Center for Health Care Quality", "author_email": null, "citation": "", "contact_email": "CDPHCHCQInformatics@cdph.ca.gov", "creator_user_id": "7bb816fb-15aa-40ce-9159-392acdbd7af2", "data_collection_tool": "Facility data were obtained from the CDPH\u2019s Electronic Licensing Management System (ELMS) database. ELMS records health facility/provider applications, issues licenses, generates license renewal notices, determines license fees, issues and tracks state enforcement actions, and generates management reports. Facility licensing applications are entered into ELMS by L&C District Office staff.  Refer to L&C's webpage for the application forms needed to apply for a healthcare facility license: https://www.cdph.ca.gov/Programs/CHCQ/LCP/Pages/ApplyForLicensure.aspx. Contact L&C District Offices to initiate a license \r\nor update facility information: https://www.cdph.ca.gov/Programs/CHCQ/LCP/Pages/HealthCareFacilities.aspx.", "data_license": "Terms of Use", "de_identification_method": "", "geo_coverage": "California", "geographic_granularity": "location point", "id": "3b5b80e8-6b8d-4715-b3c0-2699af6e72e5", "isopen": false, "language": "English (EN)", "license_id": null, "license_title": null, "limitations": "Limitations", "maintainer": null, "maintainer_email": null, "metadata_created": "2017-06-16T22:14:14.964528", "metadata_modified": "2026-10-16T20:45:08.354178", "name": "healthcare-facility-locations", "notes": "__Note:__ This web page provides data on health facilities only. To file a complaint against a facility, please see: https://www.cdph.ca.gov/Programs/CHCQ/LCP/Pages/FileAComplaint.aspx\r\n\r\nThe California Department of Public Health (CDPH), Center for Health Care Quality, Licensing and Certification (L&C) Program licenses and certifies more than 30 types of healthcare facilities. The Electronic Licensing Management System (ELMS) is a CDPH data system created to manage state licensing-related data and enforcement actions. This file includes California healthcare facilities that are operational and have a current license issued by the CDPH and/or a current U.S. Department of Health and Human Services\u2019 Centers for Medicare and Medicaid Services (CMS) certification.\r\n\r\nTo link the CDPH facility IDs with those from other Departments, like HCAI, please reference the \"Licensed Facility Cross-Walk\" Open Data table at https://data.chhs.ca.gov/dataset/licensed-facility-crosswalk.  Facility geographic variables are updated monthly, if latitude/longitude information is missing at any point in time, it should be available when the next time the Open Data facility file is refreshed.  \r\n\r\nPlease note that the file contains the data from ELMS as of the 11th business day of the month. See DATA_DATE variable for the specific date of when the data was extracted.\r\n\r\nMap of all Health Care Facilities in California: https://go.cdii.ca.gov/cdph-facilities", "num_resources": 10, "num_tags": 19, "organization": {"id": "065b3ab5-11f3-4939-9b68-421e69f34573", "name": "california-department-of-public-health", "title": "California Department of Public Health", "type": "organization", "description": "The California Department of Public Health (CDPH) works to protect the public's health in the Golden State and helps shape positive health outcomes for individuals, families and communities. The Department's programs and services, implemented in collaboration with local health departments and state, federal and private partners, touch the lives of every Californian and visitor to the state 24 hours a day, 7 days a week.", "image_url": "2024-10-21-225443.759506CDPHlogo.png", "created": "2017-05-25T19:52:10.731086", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "065b3ab5-11f3-4939-9b68-421e69f34573", "private": false, "program_web_page": "https://www.cdph.ca.gov/Programs/CHCQ/LCP/Pages/HealthCareFacilities.aspx", "related_resources": "", "secondary_sources": "", "state": "active", "temporal_coverage": "Updated monthly", "title": "Licensed and Certified Healthcare Facility Listing", "type": "dataset", "url": "https://www.cdph.ca.gov/Programs/CHCQ/LCP/CalHealthFind/Pages/Home.aspx", "version": null, "extras": [{"key": "twitter_popup", "value": "[]"}], "groups": [{"description": "", "display_name": "Facilities and Services", "id": "38f6c04a-5ec7-428e-a285-b1bb46b48692", "image_display_url": "https://data.chhs.ca.gov/uploads/group/2017-06-13-182500.0965222017-05-31-190026.331659building.svg", "name": "facilities-and-services", "title": "Facilities and Services"}], "resources": [{"accept_popup": [], "cache_last_updated": null, "cache_url": null, "ckan_url": "https://data.chhs.ca.gov", "created": "2025-04-16T23:52:39.145782", "datastore_active": true, "datastore_contains_all_records_of_source_file": true, "description": "Note: This web page provides data on health facilities only. \r\n\r\n_File update: 07/29/2026", "format": "CSV", "hash": "588a90e538502495b79040e5b97c1e8f", "id": "f0ae5731-fef8-417f-839d-54a0ed3a126e", "ignore_hash": false, "is_data_dict_populated": true, "last_modified": "2026-10-16T20:45:55.274881", "metadata_modified": "2026-10-16T20:45:08.362733", "mimetype": null, "mimetype_inner": null, "name": "Licensed and Certified Healthcare Facility Locations", "original_url": "https://data.chhs.ca.gov/dataset/3b5b80e8-6b8d-4715-b3c0-2699af6e72e5/resource/f0ae5731-fef8-417f-839d-54a0ed3a126e/download/health_facility_locations.csv", "package_id": "3b5b80e8-6b8d-4715-b3c0-2699af6e72e5", "position": 0, "resource_id": "f0ae5731-fef8-417f-839d-54a0ed3a126e", "resource_type": null, "set_url_type": false, "size": 7245936, "state": "active", "task_created": "2026-10-16 20:45:55.300800", "url": "https://data.chhs.ca.gov/dataset/3b5b80e8-6b8d-4